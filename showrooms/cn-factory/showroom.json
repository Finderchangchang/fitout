{
  "id": "cn-factory",
  "name": "国内风 · 制造工厂",
  "industry": "factory-trade",
  "niche": "manufacturing",
  "flavor": "cn",
  "note": "给机械设备、五金、零部件、建材工厂。内销为主，兼做外贸询盘。首页把厂房、工艺、产能、资质和零件摆开，内页能翻到参数和询价。",
  "buttons": {
    "primary": "索取报价",
    "primaryHref": "contact/index.html",
    "secondary": "产品中心",
    "secondaryHref": "products/index.html",
    "form": "留言询价"
  },
  "shell": {
    "header": [
      "standard"
    ],
    "footer": [
      "columns"
    ],
    "floatContact": [
      "dock"
    ]
  },
  "motion": {
    "enter": "fade",
    "distance": "30px",
    "duration": "700ms",
    "once": true,
    "count": true,
    "carousel": {
      "min": 3,
      "max": 5,
      "interval": "4000ms"
    }
  },
  "collections": [
    {
      "id": "products",
      "label": "产品中心",
      "listFile": "products/index.html"
    },
    {
      "id": "applications",
      "label": "应用领域",
      "listFile": "applications/index.html"
    },
    {
      "id": "news",
      "label": "新闻动态",
      "listFile": "news/index.html"
    }
  ],
  "pages": [
    {
      "id": "home",
      "file": "index.html",
      "kind": "home",
      "optional": false,
      "order": [
        {
          "type": "hero",
          "required": true,
          "variants": [
            "carousel"
          ]
        },
        {
          "type": "trust",
          "required": false,
          "variants": [
            "stats"
          ]
        },
        {
          "type": "services",
          "required": true,
          "variants": [
            "stagger"
          ]
        },
        {
          "type": "why",
          "required": false,
          "variants": [
            "overlay"
          ]
        },
        {
          "type": "cases",
          "required": false,
          "variants": [
            "linked"
          ]
        },
        {
          "type": "collection-list",
          "required": false,
          "variants": [
            "brief"
          ]
        },
        {
          "type": "honors",
          "required": false,
          "variants": [
            "wall"
          ]
        },
        {
          "type": "cta-band",
          "required": false,
          "variants": [
            "plate"
          ]
        }
      ]
    },
    {
      "id": "about",
      "file": "about/index.html",
      "kind": "about",
      "optional": false,
      "order": [
        {
          "type": "timeline",
          "required": false,
          "variants": [
            "rail"
          ]
        },
        {
          "type": "why",
          "required": false,
          "variants": [
            "cells"
          ]
        },
        {
          "type": "cases",
          "required": false,
          "variants": [
            "yard"
          ]
        },
        {
          "type": "trust",
          "required": false,
          "variants": [
            "stats"
          ]
        },
        {
          "type": "honors",
          "required": false,
          "variants": [
            "wall"
          ]
        }
      ]
    },
    {
      "id": "products",
      "file": "products/index.html",
      "kind": "list",
      "optional": false,
      "order": [
        {
          "type": "collection-list",
          "required": false,
          "variants": [
            "sidebar"
          ]
        }
      ]
    },
    {
      "id": "product",
      "file": "products/{slug}.html",
      "kind": "detail",
      "optional": false,
      "from": "products",
      "order": [
        {
          "type": "collection-detail",
          "required": false,
          "variants": [
            "sheet"
          ]
        }
      ]
    },
    {
      "id": "applications",
      "file": "applications/index.html",
      "kind": "list",
      "optional": true,
      "when": "档案写了产品用在哪些场景或行业。",
      "deny": [
        "没有应用场景",
        "没有应用"
      ],
      "order": [
        {
          "type": "collection-list",
          "required": false,
          "variants": [
            "mosaic"
          ]
        }
      ]
    },
    {
      "id": "application",
      "file": "applications/{slug}.html",
      "kind": "detail",
      "optional": true,
      "when": "应用列表开着，并且有对应条目。列表关掉就不生成。",
      "from": "applications",
      "order": [
        {
          "type": "collection-detail",
          "required": false,
          "variants": [
            "story"
          ]
        }
      ]
    },
    {
      "id": "news",
      "file": "news/index.html",
      "kind": "news-list",
      "optional": true,
      "when": "档案里有可以单独成篇的动态，例如换供应商、新菜单、招生或工期。",
      "deny": [
        "没有新闻",
        "没有动态",
        "不发新闻"
      ],
      "order": [
        {
          "type": "collection-list",
          "required": false,
          "variants": [
            "index"
          ]
        }
      ]
    },
    {
      "id": "news-item",
      "file": "news/{slug}.html",
      "kind": "news-detail",
      "optional": true,
      "when": "新闻列表开着，并且有对应稿件。列表关掉就不生成。",
      "from": "news",
      "order": [
        {
          "type": "collection-detail",
          "required": false,
          "variants": [
            "report"
          ]
        }
      ]
    },
    {
      "id": "contact",
      "file": "contact/index.html",
      "kind": "contact",
      "optional": false,
      "order": [
        {
          "type": "contact",
          "required": true,
          "variants": [
            "split"
          ]
        },
        {
          "type": "faq",
          "required": false,
          "variants": [
            "accordion"
          ]
        }
      ]
    }
  ]
}
