    "items": {
      "type": "list",
      "required": true,
      "min": 1,
      "max": 6,
      "item": {
        "name": { "type": "string", "required": true, "maxChars": 12 },
        "text": { "type": "string", "required": true, "maxChars": 40 },
        "price": { "type": "string", "required": false, "maxChars": 16 },
        "href": { "type": "string", "required": false, "maxChars": 200 },
        "image": { "type": "image", "required": false, "maxChars": 200 },
        "imageAlt": { "type": "string", "required": false, "maxChars": 30 }
      }
    }
  },
  "variants": {
    "lineup": {
      "needsImage": false,
      "family": "lineup",
      "fit": "松绿底上的竖图课程，课时和学费在图下",
