{
  "note": "课程列表。分类用文字下划线切换。课时和学费写在卡片上。集合列表注入会丢掉这些字段，所以这一页单独写。",
  "fields": {
    "title": { "type": "string", "required": true, "maxChars": 16 },
    "lead": { "type": "string", "required": false, "maxChars": 40 },
    "groups": {
      "type": "list",
      "required": true,
      "min": 1,
      "max": 4,
      "item": {
        "name": { "type": "string", "required": true, "maxChars": 12 },
        "items": {
          "type": "list",
          "required": true,
          "min": 1,
          "max": 4,
          "item": {
            "name": { "type": "string", "required": true, "maxChars": 12 },
            "hours": { "type": "string", "required": true, "maxChars": 12 },
            "price": { "type": "string", "required": true, "maxChars": 16 },
            "href": { "type": "string", "required": true, "maxChars": 200 },
            "image": { "type": "image", "required": true, "maxChars": 200 },
            "imageAlt": { "type": "string", "required": true, "maxChars": 30 }
          }
        }
      }
    }
  },
  "variants": {
    "tabs": {
      "needsImage": false,
      "family": "lanes",
      "fit": "分类下划线加课程卡",
      "source": "样板间自写"
    }
  }
}
