{
  "id": "cn-dining",
  "name": "国内风 · 餐饮连锁",
  "note": "给餐饮、茶饮、烘焙的连锁品牌和单店老板。用来展示产品、门店和品牌故事，并招加盟。",
  "industry": "store-service",
  "niche": "dining",
  "flavor": "cn",
  "buttons": {
    "primary": "谈加盟",
    "primaryHref": "join/index.html",
    "secondary": "看产品",
    "secondaryHref": "products/index.html",
    "form": "写给招商"
  },
  "shell": {
    "header": [
      "standard"
    ],
    "footer": [
      "columns"
    ],
    "floatContact": [
      "dock"
    ]
  },
  "motion": {
    "enter": "fade",
    "distance": "30px",
    "duration": "700ms",
    "once": true,
    "count": true,
    "carousel": {
      "min": 3,
      "max": 9,
      "interval": "4500ms"
    }
  },
  "collections": [
    {
      "id": "products",
      "label": "产品",
      "listFile": "products/index.html"
    },
    {
      "id": "stores",
      "label": "门店",
      "listFile": "stores/index.html"
    },
    {
      "id": "news",
      "label": "新闻动态",
      "listFile": "news/index.html"
    }
  ],
  "pages": [
    {
      "id": "home",
      "file": "index.html",
      "kind": "home",
      "optional": false,
      "order": [
        {
          "type": "hero",
          "required": true,
          "variants": [
            "carousel"
          ]
        },
        {
          "type": "trust",
          "required": false,
          "variants": [
            "stats"
          ]
        },
        {
          "type": "photo-band",
          "required": false,
          "variants": [
            "wide"
          ]
        },
        {
          "type": "essay",
          "required": false,
          "variants": [
            "split"
          ]
        },
        {
          "type": "mosaic",
          "required": false,
          "variants": [
            "quad"
          ]
        },
        {
          "type": "tasting",
          "required": true,
          "variants": [
            "picker"
          ]
        },
        {
          "type": "triptych",
          "required": false,
          "variants": [
            "spread"
          ]
        },
        {
          "type": "briefs",
          "required": false,
          "variants": [
            "cards"
          ]
        },
        {
          "type": "invite",
          "required": false,
          "variants": [
            "band"
          ]
        }
      ]
    },
    {
      "id": "about",
      "file": "about/index.html",
      "kind": "about",
      "optional": false,
      "order": [
        {
          "type": "essay",
          "required": false,
          "variants": [
            "split"
          ]
        },
        {
          "type": "photo-band",
          "required": false,
          "variants": [
            "wide"
          ]
        },
        {
          "type": "faq",
          "required": false,
          "variants": [
            "accordion"
          ]
        }
      ]
    },
    {
      "id": "products",
      "file": "products/index.html",
      "kind": "list",
      "optional": false,
      "order": [
        {
          "type": "collection-list",
          "required": false,
          "variants": [
            "board"
          ]
        }
      ]
    },
    {
      "id": "product",
      "file": "products/{slug}.html",
      "kind": "detail",
      "optional": false,
      "from": "products",
      "order": [
        {
          "type": "collection-detail",
          "required": false,
          "variants": [
            "article"
          ]
        }
      ]
    },
    {
      "id": "stores",
      "file": "stores/index.html",
      "kind": "list",
      "optional": true,
      "when": "档案里有两家及以上门店，要按地址列出来。",
      "deny": [
        "只有一家店",
        "只此一家",
        "没有第二家店",
        "仅此一家",
        "不设分店",
        "就这一家"
      ],
      "order": [
        {
          "type": "collection-list",
          "required": false,
          "variants": [
            "feed"
          ]
        }
      ]
    },
    {
      "id": "store",
      "file": "stores/{slug}.html",
      "kind": "detail",
      "optional": true,
      "when": "门店列表开着，并且有对应门店。列表关掉就不生成。",
      "from": "stores",
      "order": [
        {
          "type": "collection-detail",
          "required": false,
          "variants": [
            "article"
          ]
        }
      ]
    },
    {
      "id": "join",
      "file": "join/index.html",
      "kind": "join",
      "optional": true,
      "when": "档案提到招加盟、开放加盟或联营开店。",
      "deny": [
        "不招加盟",
        "不开放加盟",
        "不接受加盟",
        "不加盟",
        "只此一家"
      ],
      "order": [
        {
          "type": "why",
          "required": false,
          "variants": [
            "steps"
          ]
        },
        {
          "type": "merits",
          "required": false,
          "variants": [
            "list"
          ]
        },
        {
          "type": "inquire",
          "required": false,
          "variants": [
            "note"
          ]
        }
      ]
    },
    {
      "id": "news",
      "file": "news/index.html",
      "kind": "news-list",
      "optional": true,
      "when": "档案里有可以单独成篇的动态，例如换供应商、新菜单、招生或工期。",
      "deny": [
        "没有新闻",
        "没有动态",
        "不发新闻"
      ],
      "order": [
        {
          "type": "collection-list",
          "required": false,
          "variants": [
            "feed"
          ]
        }
      ]
    },
    {
      "id": "story",
      "file": "news/{slug}.html",
      "kind": "news-detail",
      "optional": true,
      "when": "新闻列表开着，并且有对应稿件。列表关掉就不生成。",
      "from": "news",
      "order": [
        {
          "type": "collection-detail",
          "required": false,
          "variants": [
            "article"
          ]
        }
      ]
    },
    {
      "id": "contact",
      "file": "contact/index.html",
      "kind": "contact",
      "optional": false,
      "order": [
        {
          "type": "contact",
          "required": true,
          "variants": [
            "card"
          ]
        },
        {
          "type": "inquire",
          "required": false,
          "variants": [
            "note"
          ]
        }
      ]
    }
  ]
