{
  "note": "产品分类读每条的 category。拼装按分类生成筛选，不看链接前缀。门店和新闻不写 category 时不出现筛选。",
  "fields": {
    "title": { "type": "string", "required": true, "maxChars": 16 },
    "lead": { "type": "string", "required": false, "maxChars": 40 },
    "collection": { "type": "string", "required": true, "maxChars": 40 },
    "groups": {
      "type": "list",
      "required": false,
      "max": 6,
      "item": {
        "key": { "type": "string", "required": true, "maxChars": 12 },
        "label": { "type": "string", "required": true, "maxChars": 8 },
        "on": { "type": "string", "required": false, "maxChars": 2 }
      }
    }
  },
  "variants": {
    "board": {
      "needsImage": false,
      "family": "catalog",
      "fit": "方图目录，可按分类收起"
    },
    "feed": {
      "needsImage": false,
      "family": "feed",
      "fit": "图文列表，说明里带地址或日期"
    }
  }
}
