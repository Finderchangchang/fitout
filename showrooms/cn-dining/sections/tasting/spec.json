{
  "note": "大图在左，说明在右，缩略图横排在下面。用单选切换，不是第二套轮播。",
  "fields": {
    "title": {
      "type": "string",
      "required": true,
      "maxChars": 16
    },
    "lead": {
      "type": "string",
      "required": false,
      "maxChars": 40
    },
    "moreHref": {
      "type": "string",
      "required": true,
      "maxChars": 200
    },
    "moreLabel": {
      "type": "string",
      "required": true,
      "maxChars": 8
    },
    "items": {
      "type": "list",
      "required": true,
      "min": 3,
      "max": 6,
      "item": {
        "name": {
          "type": "string",
          "required": true,
          "maxChars": 16
        },
        "text": {
          "type": "string",
          "required": true,
          "maxChars": 40
        },
        "price": {
          "type": "string",
          "required": true,
          "maxChars": 8
        },
        "image": {
          "type": "image",
          "required": true,
          "maxChars": 200
        },
        "imageAlt": {
          "type": "string",
          "required": true,
          "maxChars": 30
        },
        "on": {
          "type": "string",
          "required": false,
          "maxChars": 2
        }
      }
    }
  },
  "variants": {
    "picker": {
      "needsImage": true,
      "imageField": "items.image",
      "family": "picker",
      "fit": "大图加横排缩略",
      "fallback": "text-list"
    },
    "menu": {
      "needsImage": false,
      "family": "menu",
      "fit": "图文菜单，缺图仍完整显示菜名、说明和价格。"
    },
    "text-list": {
      "needsImage": false,
      "family": "text-catalog",
      "fit": "无照片时保留业务、规格和联系信息",
      "source": "样板间自写"
    }
  }
}
