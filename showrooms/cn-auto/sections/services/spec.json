{
  "note": "首页五个工位。参考价写在卡上，详情里再写时间和质保。",
  "fields": {
    "title": {
      "type": "string",
      "required": true,
      "maxChars": 16
    },
    "lead": {
      "type": "string",
      "required": false,
      "maxChars": 40
    },
    "items": {
      "type": "list",
      "required": true,
      "min": 3,
      "max": 6,
      "item": {
        "name": {
          "type": "string",
          "required": true,
          "maxChars": 12
        },
        "text": {
          "type": "string",
          "required": true,
          "maxChars": 40
        },
        "price": {
          "type": "string",
          "required": false,
          "maxChars": 16
        },
        "href": {
          "type": "string",
          "required": true,
          "maxChars": 200
        },
        "image": {
          "type": "image",
          "required": true,
          "maxChars": 200
        },
        "imageAlt": {
          "type": "string",
          "required": true,
          "maxChars": 30
        }
      }
    }
  },
  "variants": {
    "bays": {
      "needsImage": true,
      "imageField": "items.image",
      "family": "bays",
      "fit": "一张大卡加四张小卡，不对称",
      "source": "样板间自写。不搬等宽三卡，也不搬蓝胶囊按钮",
      "fallback": "text-list"
    },
    "text-list": {
      "needsImage": false,
      "family": "text-catalog",
      "fit": "无照片时保留业务、规格和联系信息",
      "source": "样板间自写"
    }
  }
}
