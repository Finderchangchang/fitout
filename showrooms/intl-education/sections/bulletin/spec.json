{
  "note": "首页动态。日期写在摘要里也会再单列一行。不占集合列表的名额。",
  "fields": {
    "title": { "type": "string", "required": true, "maxChars": 16 },
    "lead": { "type": "string", "required": false, "maxChars": 40 },
    "items": {
      "type": "list",
      "required": true,
      "min": 1,
      "max": 6,
      "item": {
        "date": { "type": "string", "required": true, "maxChars": 16 },
        "name": { "type": "string", "required": true, "maxChars": 16 },
        "summary": { "type": "string", "required": true, "maxChars": 80 },
        "href": { "type": "string", "required": true, "maxChars": 200 },
        "image": { "type": "image", "required": false, "maxChars": 200 },
        "imageAlt": { "type": "string", "required": false, "maxChars": 30 }
      }
    }
  },
  "variants": {
    "feed": {
      "needsImage": false,
      "family": "feed",
      "fit": "三列等宽的动态卡",
      "source": "样板间自写"
    }
  }
}
