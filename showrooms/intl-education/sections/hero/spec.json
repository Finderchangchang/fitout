{
  "note": "满屏轮播。标题压在压暗的实拍上。右侧可以叠课程封面，封面从档案来，没有就不画。",
  "fields": {
    "label": { "type": "string", "required": false, "maxChars": 12 },
    "title": { "type": "string", "required": true, "maxChars": 80 },
    "lead": { "type": "string", "required": true, "maxChars": 40 },
    "primaryLabel": { "type": "string", "required": true, "maxChars": 8 },
    "primaryHref": { "type": "string", "required": true, "maxChars": 200 },
    "secondaryLabel": { "type": "string", "required": false, "maxChars": 8 },
    "secondaryHref": { "type": "string", "required": false, "maxChars": 200 },
    "interval": { "type": "string", "required": false, "maxChars": 8 },
    "slides": {
      "type": "list",
      "required": false,
      "min": 0,
      "max": 9,
      "item": {
        "image": { "type": "image", "required": true, "maxChars": 200 },
        "imageAlt": { "type": "string", "required": true, "maxChars": 30 },
        "title": { "type": "string", "required": false, "maxChars": 80 },
        "lead": { "type": "string", "required": false, "maxChars": 40 }
      }
    },
    "posters": {
      "type": "list",
      "required": false,
      "min": 0,
      "max": 4,
      "item": {
        "image": { "type": "image", "required": true, "maxChars": 200 },
        "imageAlt": { "type": "string", "required": true, "maxChars": 30 }
      }
    }
  },
  "variants": {
    "carousel": {
      "needsImage": true,
      "imageField": "slides.image",
      "fallback": "text",
      "family": "stage",
      "fit": "满屏轮播，字压在图上，封面可叠在右侧",
      "source": "样板间自写"
    },
    "text": {
      "needsImage": false,
      "family": "editorial",
      "fit": "没有照片时的文字首屏",
      "source": "框架文字首屏"
    }
  }
}
