{
  "note": "首页团队条。年限和擅长写在姓名下面。",
  "fields": {
    "title": { "type": "string", "required": true, "maxChars": 16 },
    "lead": { "type": "string", "required": false, "maxChars": 40 },
    "items": {
      "type": "list",
      "required": true,
      "min": 1,
      "max": 6,
      "item": {
        "name": { "type": "string", "required": true, "maxChars": 12 },
        "role": { "type": "string", "required": true, "maxChars": 16 },
        "years": { "type": "string", "required": false, "maxChars": 8 },
        "focus": { "type": "string", "required": false, "maxChars": 16 },
        "text": { "type": "string", "required": false, "maxChars": 40 },
        "href": { "type": "string", "required": false, "maxChars": 200 },
        "image": { "type": "image", "required": false, "maxChars": 200 },
        "imageAlt": { "type": "string", "required": false, "maxChars": 30 }
      }
    }
  },
  "variants": {
    "bench": {
      "needsImage": false,
      "family": "bench",
      "fit": "深色底上的环境人像",
      "source": "样板间自己的团队条"
    }
  }
}
