{
  "note": "在售账本。一行一款，图在左，产地和两档价写在说明里。",
  "fields": {
    "title": { "type": "string", "required": true, "maxChars": 16 },
    "lead": { "type": "string", "required": false, "maxChars": 40 },
    "items": {
      "type": "list",
      "required": true,
      "min": 3,
      "max": 6,
      "item": {
        "name": { "type": "string", "required": true, "maxChars": 20 },
        "summary": { "type": "string", "required": true, "maxChars": 80 },
        "href": { "type": "string", "required": true, "maxChars": 200 },
        "image": { "type": "image", "required": true, "maxChars": 200 },
        "imageAlt": { "type": "string", "required": true, "maxChars": 30 }
      }
    }
  },
  "variants": {
    "board": {
      "needsImage": true,
      "imageField": "items.image",
      "fallback": "board",
      "family": "ledger",
      "fit": "四行在售，不做成三列宫格",
      "source": "样板间自写"
    }
  }
}
