{
  "note": "相册墙。同一组图用同一个比例。",
  "fields": {
    "title": {
      "type": "string",
      "required": true,
      "maxChars": 16
    },
    "lead": {
      "type": "string",
      "required": false,
      "maxChars": 40
    },
    "items": {
      "type": "list",
      "required": true,
      "min": 4,
      "max": 12,
      "item": {
        "caption": {
          "type": "string",
          "required": true,
          "maxChars": 20
        },
        "image": {
          "type": "image",
          "required": true,
          "maxChars": 200
        },
        "imageAlt": {
          "type": "string",
          "required": true,
          "maxChars": 30
        }
      }
    }
  },
  "variants": {
    "wall": {
      "needsImage": true,
      "imageField": "items.image",
      "family": "wall",
      "fit": "作品墙，说明在图下",
      "fallback": "text-list"
    },
    "text-list": {
      "needsImage": false,
      "family": "text-catalog",
      "fit": "无照片时保留业务、规格和联系信息",
      "source": "样板间自写"
    }
  }
}
