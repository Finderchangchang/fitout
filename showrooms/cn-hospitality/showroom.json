      "order": [
        { "type": "collection-detail", "required": true, "variants": ["article"] }
      ]
    },
    {
      "id": "places",
      "file": "places/index.html",
      "kind": "list",
      "order": [
        { "type": "collection-list", "required": true, "variants": ["board"] }
      ]
    },
    {
      "id": "place",
      "file": "places/{slug}.html",
      "kind": "detail",
      "from": "places",
      "order": [
        { "type": "collection-detail", "required": true, "variants": ["article"] }
      ]
    },
    {
      "id": "dining",
      "file": "dining/index.html",
      "kind": "list",
      "order": [
        { "type": "supper", "required": true, "variants": ["board"] },
        { "type": "faq", "required": false, "variants": ["accordion"] }
