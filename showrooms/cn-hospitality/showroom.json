      "order": [
        { "type": "contact", "required": true, "variants": ["card"] },
        { "type": "transit", "required": true, "variants": ["list"] },
        { "type": "faq", "required": true, "variants": ["accordion"] },
        { "type": "inquire", "required": false, "variants": ["note"] }
