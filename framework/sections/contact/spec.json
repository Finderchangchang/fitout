{
  "note": "电话、地址、营业时间、微信来自 site.json 的 contact，不要在 data 里再写一遍。不嵌地图，不做可提交的表单。",
  "fields": {
    "title": {
      "type": "string",
      "required": true,
      "maxChars": 16,
      "hint": "区块标题"
    },
    "lead": {
      "type": "string",
      "required": false,
      "maxChars": 40,
      "hint": "可无"
    },
    "qrs": {
      "type": "list",
      "required": false,
      "max": 4,
      "hint": "二维码，可无。客户没给文件时正式站这一块整个不出",
      "item": {
        "image": { "type": "image", "required": true, "maxChars": 200 },
        "imageAlt": { "type": "string", "required": true, "maxChars": 30 },
        "label": { "type": "string", "required": true, "maxChars": 8 }
      }
    }
  },
  "variants": {
    "card": {
      "needsImage": false,
      "family": "visit",
      "fit": "时间一块，地址和电话一块",
      "source": "语义结构与实现约定见 docs/FRAMEWORK.md；第三方许可见 NOTICE。"
    },
    "banner": {
      "needsImage": false,
      "family": "banner",
      "fit": "横过来的同一组信息",
      "source": "语义结构与实现约定见 docs/FRAMEWORK.md；第三方许可见 NOTICE。"
    }
  }
}
