{
  "note": "条目来自 site.json 的 products，由拼装脚本注入，不要在 data 里再写一份。卡片固定四要素：缩略图、标题、两行摘要、日期或标签。data.pageSize 默认 9，超过才在列表页静态分页。",
  "fields": {
    "title": {
      "type": "string",
      "required": true,
      "maxChars": 16,
      "hint": "目录标题"
    },
    "lead": {
      "type": "string",
      "required": false,
      "maxChars": 40,
      "hint": "可无"
    }
  },
  "variants": {
    "grid": {
      "needsImage": false,
      "family": "catalog",
      "fit": "产品卡片。没图就不出图片",
      "source": "语义结构与实现约定见 docs/FRAMEWORK.md；第三方许可见 NOTICE。"
    },
    "rows": {
      "needsImage": false,
      "family": "menu",
      "fit": "产品逐行",
      "source": "同一信息，改成行"
    }
  }
}
